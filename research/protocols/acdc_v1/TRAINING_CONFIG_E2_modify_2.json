{
  "protocol": "acdc_v1",
  "model": "E2_modify_2_channel_grouped_2D_bidirectional_scan",
  "dataset_source": "mathpluscode/ACDC",
  "dataset_revision": "4a312b610f395eda5dc0aa36f087dd6ca9991e41",
  "classes": {"0": "background", "1": "right_ventricle", "2": "myocardium", "3": "left_ventricle"},
  "input_size": [192, 192],
  "input_channels": 3,
  "intensity_transform": "uint8_to_float32_divide_by_255",
  "training_augmentation": "joint_random_rot90_flip_or_random_rotation_minus20_to_plus19_degrees",
  "validation_augmentation": "none",
  "test_augmentation": "none",
  "include_all_ed_es_slices": true,
  "batch_size": 32,
  "optimizer": "AdamW",
  "learning_rate": 0.001,
  "weight_decay": 0.01,
  "scheduler": "CosineAnnealingLR_Tmax100_eta_min_1e-5",
  "loss": "CrossEntropy_plus_multiclass_Dice_equal_weights",
  "epochs": 300,
  "seeds": [42, 3407, 2026],
  "checkpoint_rule": "maximum_validation_mean_Dice_then_minimum_validation_mean_HD95_mm",
  "validation_unit": "3D_patient_phase_volume",
  "test_access_during_training": false
}
